# Prefer: node scripts/configure.mjs (creates random credentials and Kubernetes Secret)
POSTGRES_PASSWORD=replace-with-generated-password
PROJECT_DB_PASSWORD=replace-with-generated-password
TASK_DB_PASSWORD=replace-with-generated-password
INTERNAL_TOKEN=replace-with-random-token-at-least-32-characters
PROJECT_DATABASE_URL=postgresql://project_user:replace-with-generated-password@localhost:5434/taskflow?schema=projects
TASK_DATABASE_URL=postgresql://task_user:replace-with-generated-password@localhost:5434/taskflow?schema=tasks
